{
  "name": "coclaude",
  "version": "0.2.0",
  "type": "module",
  "description": "Multiplayer Claude Code — pair-program with teammates inside the same Claude Code session",
  "keywords": [
    "claude",
    "claude-code",
    "multiplayer",
    "pair-programming",
    "ai",
    "agent",
    "tui",
    "collaboration"
  ],
  "homepage": "https://github.com/adechassey/coclaude#readme",
  "bugs": {
    "url": "https://github.com/adechassey/coclaude/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adechassey/coclaude.git"
  },
  "license": "MIT",
  "author": "adechassey <12235204+adechassey@users.noreply.github.com>",
  "bin": {
    "coclaude": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PLAN.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p . && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.9",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.140",
    "commander": "^14.0.3",
    "ink": "^7.0.3",
    "react": "^19.2.6",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/ws": "^8.18.1",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
